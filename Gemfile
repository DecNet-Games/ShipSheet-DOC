source "https://rubygems.org"

# GitHub Pages (classic builder) provides the Jekyll environment through
# this gem; the Just the Docs theme is loaded via remote_theme in
# _config.yml. Keep this Gemfile free of a `just-the-docs` theme gem:
# theme-gem + Pages is the combination behind the known build errors
# "The just-the-docs theme could not be found" and "The github-pages gem
# can't satisfy your Gemfile's dependencies".
gem "github-pages", group: :jekyll_plugins
